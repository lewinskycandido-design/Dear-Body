{%- liquid
 assign seo_title = page_title
 assign seo_description = page_description
 assign default_title = ''
 assign default_description = ''
 assign entity_title = ''
 if template.name == 'index'
  assign default_title = settings.home_seo_title
  assign default_description = settings.home_seo_description
  assign entity_title = shop.name
 elsif template.name == 'collection'
  assign entity_title = collection.title
  assign audience = ''
  if settings.for_her_collection != blank and collection.id == settings.for_her_collection.id
   assign audience = 'women'
  elsif settings.for_him_collection != blank and collection.id == settings.for_him_collection.id
   assign audience = 'men'
  elsif settings.launch_collection != blank and collection.id == settings.launch_collection.id
   assign audience = 'launch'
  endif
  if template.suffix == 'women' or template.suffix == 'men' or template.suffix == 'launch'
   assign audience = template.suffix
  endif
  if audience == 'women'
   assign default_title = "DearBody Women's Perfume Philippines | London-Formulated Fragrances"
   assign default_description = "Discover DearBody women's perfumes in the Philippines. Explore London-formulated fragrances curated for Filipino style, everyday moments and tropical living. Find a scent that expresses you."
  elsif audience == 'men'
   assign default_title = "DearBody Men's Perfume Philippines | London-Formulated Fragrances"
   assign default_description = "Explore DearBody men's perfumes in the Philippines. Discover London-formulated scents curated for Filipino lifestyles, from fresh everyday fragrance to deeper evening profiles."
  elsif audience == 'launch'
   assign default_title = 'DearBody Launch Collection | Six Signature Fragrances Philippines'
   assign default_description = 'Meet the DearBody launch fragrance collection: six London-formulated scents spanning soft sweetness, juicy berries, warm spice, smoky woods and glowing trails.'
  elsif collection.url == routes.all_products_collection_url
   assign default_title = 'DearBody Perfumes Philippines | Shop the Fragrance Collection'
   assign default_description = 'Shop DearBody perfumes in the Philippines. Discover London-formulated fragrances with fresh, sweet, warm, smoky and indulgent scent profiles curated for everyday Filipino life.'
  endif
 elsif template.name == 'page'
  assign entity_title = page.title
  assign page_kind = template.suffix
  if settings.scent_finder_page != blank and page.id == settings.scent_finder_page.id
   assign page_kind = 'scent-finder'
  elsif settings.story_page != blank and page.id == settings.story_page.id
   assign page_kind = 'our-story'
  endif
  if page_kind == 'scent-finder'
   assign default_title = 'DearBody Scent Finder Philippines | Explore Your Fragrance Style'
   assign default_description = 'Explore your DearBody scent journey. Discover London-formulated fragrances around your mood, preferred scent style and everyday moments.'
  elsif page_kind == 'our-story'
   assign default_title = 'About DearBody Philippines | A Scent Journey from London'
   assign default_description = "Discover DearBody Philippines, bringing London's fragrance culture into Filipino everyday life through thoughtfully curated scents for local tastes, lifestyles and everyday moments."
  endif
 endif
 if default_title != blank
  if seo_title == blank or seo_title == entity_title or template.name == 'index'
   assign seo_title = default_title
  endif
 endif
 if seo_description == blank and default_description != blank
  assign seo_description = default_description
 endif
 if field == 'title'
  echo seo_title
 else
  echo seo_description
 endif
-%}
