{% liquid
  assign card_name = product.title | default: fallback_name
  assign card_url = product.url
  assign card_variant = product.selected_or_first_available_variant
  assign quick_form_id = 'db-quick-add-' | append: section.id | append: '-' | append: product.id
  assign simple_quantity_rule = true
  if card_variant.quantity_rule.min > 1 or card_variant.quantity_rule.increment > 1 or card_variant.quantity_rule.max != blank or product.requires_selling_plan
    assign simple_quantity_rule = false
  endif
%}
<article class="db-card">
  {% if card_url != blank %}<a class="db-card-image" href="{{ card_url }}" aria-label="Explore {{ card_name | escape }}">{% else %}<div class="db-card-image">{% endif %}
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 900 | image_tag: widths: '300, 500, 700, 900', sizes: '(max-width: 700px) 50vw, 33vw', loading: 'lazy', alt: card_name }}
    {% elsif product == blank and fallback_image != blank %}
      <img src="{{ fallback_image | asset_url }}" alt="{{ card_name | escape }} bottle and presentation canister" width="900" height="900" loading="lazy">
    {% else %}<div class="db-no-image">{{ card_name | escape }}</div>{% endif %}
    {% if card_url != blank %}<span class="db-card-arrow" aria-hidden="true">↗</span>{% endif %}
  {% if card_url != blank %}</a>{% else %}</div>{% endif %}
  <div class="db-card-meta">
    <h3>{% if card_url != blank %}<a href="{{ card_url }}">{{ card_name | escape }}</a>{% else %}{{ card_name | escape }}{% endif %}</h3>
    <p>{% if product != blank %}{% if product.price_varies %}From {% endif %}{{ product.price | money_with_currency }}{% else %}Price set in Shopify{% endif %}</p>
  </div>
  {% if product.metafields.custom.short_description.value != blank %}<p class="db-card-personality">{{ product.metafields.custom.short_description.value | escape }}</p>{% endif %}
  {% if card_url != blank %}
    {% if product.has_only_default_variant and product.variants.size == 1 and simple_quantity_rule %}
      {% form 'product', product, id: quick_form_id, class: 'db-card-quick-add' %}
        <input type="hidden" name="id" value="{{ card_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" name="add" class="db-button db-button--outline" aria-label="{% if card_variant.available %}Add {{ card_name | escape }} to bag{% else %}{{ card_name | escape }} is unavailable{% endif %}" {% if card_variant.available == false %}disabled{% endif %}>
          {% if card_variant.available == false %}Sold out{% else %}Quick add{% endif %}
        </button>
      {% endform %}
    {% else %}<a class="db-button db-button--outline db-card-options" href="{{ card_url }}">Choose options<span class="db-visually-hidden"> for {{ card_name | escape }}</span></a>{% endif %}
  {% endif %}
</article>
