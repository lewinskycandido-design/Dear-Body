<footer class="db-footer"><div class="db-container"><div class="db-footer-top"><a class="db-wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">{% if settings.footer_logo %}{{ settings.footer_logo | image_url: width: 440 | image_tag: width: 220, loading: 'lazy', alt: shop.name }}{% else %}<span class="db-home-link">Home</span>{% endif %}</a><p>{{ section.settings.statement | escape | newline_to_br }}</p></div><div class="db-footer-columns"><div><p class="db-kicker">Your next chapter</p><nav aria-label="Footer navigation">{% render 'db-navigation', menu: section.settings.shop_menu %}<a href="{{ routes.all_products_collection_url }}">Shop all</a></nav></div><div><p class="db-kicker">Here to help</p><nav aria-label="Customer care">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</nav></div><div class="db-footer-note">{% render 'db-secondary-logo' %}<p>{{ section.settings.contact_text | escape | newline_to_br }}</p>{% if section.settings.contact_email != blank %}<a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email | escape }}</a>{% endif %}<nav class="db-social-links" aria-label="Social media">{% for block in section.blocks %}{% if block.settings.url != blank %}<a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{% endif %}{% endfor %}</nav></div></div><p class="db-footer-statement">A SCENT JOURNEY.</p><div class="db-footer-bottom"><small>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</small><a href="#MainContent">Back to top ↑</a></div></div></footer>
{% schema %}
{
  "name": "DearBody footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Customer care menu"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shopping menu"
    },
    {
      "type": "textarea",
      "id": "statement",
      "label": "Brand statement",
      "default": "LONDON-FORMULATED.\nCURATED FOR FILIPINO LIFE."
    },
    {
      "type": "textarea",
      "id": "contact_text",
      "label": "Contact or brand note",
      "default": "Fragrance for your mood.\nYour moments. Your story."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email"
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Social link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Instagram"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Profile URL"
        }
      ]
    }
  ],
  "max_blocks": 5
}
{% endschema %}
