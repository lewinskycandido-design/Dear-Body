<div data-db-recommendations data-section-id="{{ section.id }}" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id | url_encode }}&amp;product_id={{ product.id }}&amp;limit={{ section.settings.limit }}&amp;intent=related">
  {% if recommendations.performed and recommendations.products_count > 0 %}
    <section class="db-section db-recommendations" aria-labelledby="db-recommendations-{{ section.id }}">
      <div class="db-container">
        <div class="db-section-heading"><div><p class="db-kicker">Continue your scent journey</p><h2 id="db-recommendations-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div></div>
        <div class="db-product-grid">{% for product in recommendations.products %}{% render 'db-product-card', product: product %}{% endfor %}</div>
      </div>
    </section>
  {% endif %}
</div>
{% schema %}
{
  "name":"Product recommendations",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Your next chapter"},
    {"type":"range","id":"limit","label":"Products to show","min":2,"max":6,"step":1,"default":3}
  ],
  "presets":[{"name":"Product recommendations"}],
  "enabled_on":{"templates":["product"]}
}
{% endschema %}
