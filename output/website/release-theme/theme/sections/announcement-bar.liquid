{% if section.settings.text != blank %}<div class="db-announcement">{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>{% else %}{{ section.settings.text | escape }}{% endif %}</div>{% endif %}
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement",
      "default": "YOUR SCENT JOURNEY STARTS HERE."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
