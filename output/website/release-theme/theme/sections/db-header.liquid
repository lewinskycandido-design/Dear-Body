<header class="db-header"><div class="db-container db-header-inner">
<a href="{{ routes.root_url }}" class="db-wordmark" aria-label="{{ shop.name | escape }} home">{% render 'db-logo' %}</a>
<nav class="db-desktop-nav" aria-label="Main navigation">{% render 'db-navigation', menu: section.settings.menu %}</nav>
<div class="db-header-actions">
<details class="db-search-disclosure"><summary aria-label="Search fragrances"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/></svg></summary>
<div class="db-search-panel"><form data-db-search data-predictive-url="{{ routes.predictive_search_url }}" action="{{ routes.search_url }}" method="get" role="search"><label for="HeaderSearch-{{ section.id }}">Find your fragrance</label><div class="db-search-field"><input id="HeaderSearch-{{ section.id }}" name="q" type="search" autocomplete="off" placeholder="Search fragrances"><input type="hidden" name="type" value="product"><button type="submit" class="db-button">Search</button></div><div data-db-search-results hidden></div><p data-db-search-status role="status" aria-live="polite" class="db-visually-hidden"></p></form></div></details>
{% if shop.customer_accounts_enabled %}<a class="db-account" href="{{ routes.account_url }}" aria-label="Your account"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 22v-3a8 8 0 0 1 16 0v3"/></svg></a>{% endif %}
<a href="{{ routes.cart_url }}" class="db-bag" aria-label="Shopping bag, {{ cart.item_count }} items"><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 7h14l1 15H4L5 7Z"/><path d="M8 8V5a4 4 0 0 1 8 0v3"/></svg><span data-db-cart-count>{{ cart.item_count }}</span></a>
<details class="db-mobile-menu"><summary aria-label="Open navigation"><svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 7h20M2 16h20"/></svg></summary><nav aria-label="Mobile navigation">{% render 'db-navigation', menu: section.settings.menu %}</nav></details>
</div></div></header>
{% if request.design_mode and settings.logo == blank %}<p class="db-editor-note">Choose the official primary logo under Theme settings → Official brand assets.</p>{% endif %}
{% schema %}
{
  "name": "DearBody header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main navigation menu"
    }
  ]
}
{% endschema %}
