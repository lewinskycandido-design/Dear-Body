{% capture escaped_less_than %}\u003c{% endcapture %}
{{ 'dearbody-quiz.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dearbody-quiz.js' | asset_url }}" defer></script>
{% liquid
  assign finder_id = 'DearBodyScentFinder-' | append: section.id
  assign attribute_keys = 'scent_character,mood,occasion,intensity,gender' | split: ','
  assign emitted_count = 0
  assign emitted_ids = '|'
  assign browse_url = section.settings.browse_collection.url | default: routes.all_products_collection_url
  assign fallback_heading = section.settings.fallback_heading | default: 'Your scent journey starts with a little curiosity.'
  assign fallback_text = section.settings.fallback_text | default: 'Our scent finder is being prepared. Explore the collection and discover the scent descriptions in the meantime.'
  assign browse_label = section.settings.browse_label | default: 'Explore all fragrances'
%}
<section id="{{ finder_id }}" class="db-scent-quiz db-section db-discovery-scheme--{{ section.settings.color_scheme }}" style="--db-discovery-space: {{ section.settings.spacing }}px" data-scent-finder aria-labelledby="{{ finder_id }}-title">
  <div class="db-container db-quiz-shell">
    <header class="db-quiz-header">
      <p class="db-kicker">{{ section.settings.eyebrow | escape }}</p>
      <h2 id="{{ finder_id }}-title">{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.text | escape }}</p>
    </header>
    <div data-quiz-content>
      <h3 class="db-quiz-empty-title">{{ fallback_heading | escape }}</h3>
      <p class="db-quiz-hint">{{ fallback_text | escape }}</p>
      <a class="db-button" href="{{ browse_url }}">{{ browse_label | escape }}</a>
      <noscript><p class="db-quiz-hint">Enable JavaScript to use the scent finder.</p></noscript>
    </div>
    <p class="db-quiz-status db-visually-hidden" data-quiz-status role="status" aria-live="polite" aria-atomic="true"></p>
    {% if request.design_mode %}
      <aside class="db-discovery-setup">
        <strong>Scent finder setup</strong>
        <p>Select a collection (up to its first 50 products) or use the six product pickers. Products appear only when <code>custom.scent_finder_enabled</code> is a Boolean set to true. Add confirmed <code>custom.scent_character</code>, <code>custom.mood</code>, <code>custom.occasion</code>, <code>custom.intensity</code> or <code>custom.gender</code> as single line text or a list of single line text. Questions appear only for supplied fields. Product names, photos, prices and availability come from Shopify.</p>
      </aside>
    {% endif %}
  </div>
  <script type="application/json" data-quiz-catalog>
    {
      "fallbackHeading": {{ fallback_heading | json | replace: '<', escaped_less_than }},
      "fallbackText": {{ fallback_text | json | replace: '<', escaped_less_than }},
      "browseLabel": {{ browse_label | json | replace: '<', escaped_less_than }},
      "allProductsUrl": {{ browse_url | json | replace: '<', escaped_less_than }},
      "products": [
        {% for index in (0..49) %}
          {% liquid
            if section.settings.collection != blank
              assign quiz_product = section.settings.collection.products[index]
            else
              if index > 5
                break
              endif
              assign picker_number = index | plus: 1
              assign picker_key = 'product_' | append: picker_number
              assign quiz_product = section.settings[picker_key]
            endif
            assign product_key = quiz_product.id | prepend: '|' | append: '|'
          %}
          {% if quiz_product != blank and quiz_product.metafields.custom.scent_finder_enabled.type == 'boolean' and quiz_product.metafields.custom.scent_finder_enabled.value == true %}
            {% unless emitted_ids contains product_key %}
              {% if emitted_count > 0 %},{% endif %}
              {
                "id": {{ quiz_product.id | append: '' | json }},
                "enabled": true,
                "name": {{ quiz_product.title | json | replace: '<', escaped_less_than }},
                "url": {{ quiz_product.url | json | replace: '<', escaped_less_than }},
                "image": {% if quiz_product.featured_image %}{{ quiz_product.featured_image | image_url: width: 600 | json | replace: '<', escaped_less_than }}{% else %}null{% endif %},
                "imageAlt": {{ quiz_product.featured_image.alt | default: quiz_product.title | json | replace: '<', escaped_less_than }},
                "description": {{ quiz_product.metafields.custom.short_description.value | default: '' | strip_html | json | replace: '<', escaped_less_than }},
                "price": {{ quiz_product.price | money_with_currency | json | replace: '<', escaped_less_than }},
                "priceVaries": {{ quiz_product.price_varies | json }},
                "available": {{ quiz_product.available | json }},
                "attributes": {
                  {% for attribute_key in attribute_keys %}
                    {% assign attribute = quiz_product.metafields.custom[attribute_key] %}
                    {{ attribute_key | json }}: {% if attribute.type == 'list.single_line_text_field' or attribute.type == 'single_line_text_field' %}{{ attribute.value | json | replace: '<', escaped_less_than }}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                }
              }
              {% assign emitted_count = emitted_count | plus: 1 %}
              {% assign emitted_ids = emitted_ids | append: product_key %}
            {% endunless %}
          {% endif %}
        {% endfor %}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "DearBody scent quiz",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FOLLOW YOUR FEELING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A little closer to your scent."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introduction",
      "default": "Choose the scent qualities that speak to you. You can leave any question open."
    },
    {
      "type": "paragraph",
      "content": "Only enabled products with confirmed scent metafields are used. No fragrance attributes or collection assignments are inferred."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection",
      "info": "Uses the first 50 products. When selected, this takes priority over the product pickers."
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Mojito Metallique"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Amber Oud Silk"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Mistened Narcissus"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Charme Envoûtant"
    },
    {
      "type": "product",
      "id": "product_5",
      "label": "Oud Mirage"
    },
    {
      "type": "product",
      "id": "product_6",
      "label": "Rtulle & Satin"
    },
    {
      "type": "header",
      "content": "When profiles are unavailable"
    },
    {
      "type": "text",
      "id": "fallback_heading",
      "label": "Fallback heading",
      "default": "Your scent journey starts with a little curiosity."
    },
    {
      "type": "textarea",
      "id": "fallback_text",
      "label": "Fallback text",
      "default": "Our scent finder is being prepared. Explore the collection and discover the scent descriptions in the meantime."
    },
    {
      "type": "collection",
      "id": "browse_collection",
      "label": "Browse collection"
    },
    {
      "type": "text",
      "id": "browse_label",
      "label": "Browse link",
      "default": "Explore all fragrances"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "cream",
          "label": "Warm cream"
        },
        {
          "value": "gold",
          "label": "Warm gold"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "cream"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Vertical spacing",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "DearBody scent quiz"
    }
  ]
}
{% endschema %}
