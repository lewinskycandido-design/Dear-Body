{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign active_media = current_variant.featured_media | default: product.featured_media
  assign product_form_id = 'db-product-form-' | append: section.id
  assign lifestyle_photos = ''
  assign lifestyle_identity = product.title | downcase | strip
  case lifestyle_identity
    when 'mojito metallique', 'mojito métallique', 'amber oud silk', 'mistened narcissus'
      assign lifestyle_photos = 'db-lifestyle-for-her.jpg,db-lifestyle-collection.jpg'
    when 'oud mirage', 'charme envoûtant', 'charme envoutant', 'rtulle & satin', 'rtulle and satin'
      assign lifestyle_photos = 'db-lifestyle-for-him.jpg,db-lifestyle-collection.jpg'
  endcase
  assign lifestyle_photos = lifestyle_photos | split: ','
  assign gallery_count = product.media.size | plus: lifestyle_photos.size
  assign can_purchase = false
  if current_variant.available and current_variant.price > 0
    assign can_purchase = true
  endif
%}

<section class="db-section" data-db-product data-section-id="{{ section.id }}">
  <div class="db-container">
    <nav class="db-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">All fragrances</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title | escape }}</span>
    </nav>

    <div class="db-product-layout">
      <div class="db-gallery" aria-label="{{ product.title | escape }} media">
        <div class="db-gallery__panels">
          {% for media in product.media %}
            <div
              id="db-media-{{ section.id }}-{{ media.id }}"
              class="db-gallery__panel"
              data-db-media-panel
              data-db-media-panels
              data-db-media-id="{{ media.id }}"
              role="group"
              aria-label="Media {{ forloop.index }} of {{ gallery_count }}"
              {% unless media.id == active_media.id %}hidden{% endunless %}
            >
              {% if media.media_type == 'image' %}
                {% liquid
                  assign image_alt = media.alt | default: product.title
                  assign image_loading = 'lazy'
                  if media.id == active_media.id
                    assign image_loading = 'eager'
                  endif
                %}
                {{ media | image_url: width: 1800 | image_tag: widths: '360, 540, 720, 960, 1200, 1800', sizes: '(min-width: 990px) 55vw, 100vw', loading: image_loading, alt: image_alt, class: 'db-gallery__image' }}
              {% else %}
                {{ media | media_tag: controls: true }}
              {% endif %}
            </div>
          {% else %}
            {% if lifestyle_photos.size == 0 %}
              <div class="db-gallery__placeholder">
                <span>{{ product.title | escape }}</span>
              </div>
            {% endif %}
          {% endfor %}
          {% for lifestyle_photo in lifestyle_photos %}
            {% render 'db-lifestyle-product-photo', photo: lifestyle_photo, product: product, section_id: section.id, photo_index: forloop.index, mode: 'panel' %}
          {% endfor %}
        </div>

        {% if gallery_count > 1 %}
          <div class="db-gallery__thumbnails" aria-label="Choose product media">
            {% for media in product.media %}
              <button
                class="db-gallery__thumbnail"
                type="button"
                data-db-media-target="db-media-{{ section.id }}-{{ media.id }}"
                aria-controls="db-media-{{ section.id }}-{{ media.id }}"
                aria-label="View media {{ forloop.index }} of {{ gallery_count }} for {{ product.title | escape }}"
                aria-pressed="{% if media.id == active_media.id %}true{% else %}false{% endif %}"
              >
                {% if media.preview_image %}
                  {{ media.preview_image | image_url: width: 180 | image_tag: widths: '90, 180', sizes: '80px', loading: 'lazy', alt: '', class: 'db-gallery__thumbnail-image' }}
                {% else %}
                  <span>{{ forloop.index }}</span>
                {% endif %}
                {% if media.media_type != 'image' %}
                  <span class="db-gallery__media-type">{% if media.media_type == 'model' %}3D{% else %}Video{% endif %}</span>
                {% endif %}
              </button>
            {% endfor %}
            {% for lifestyle_photo in lifestyle_photos %}
              {% render 'db-lifestyle-product-photo', photo: lifestyle_photo, product: product, section_id: section.id, photo_index: forloop.index, mode: 'thumbnail' %}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="db-product-info">
        <p class="db-kicker">Dear Body</p>
        <h1 class="db-title">{{ product.title | escape }}</h1>
        {% if product.type != blank %}<p class="db-product-info__type">{{ product.type | escape }}</p>{% endif %}
        <p class="db-price" data-db-price aria-live="polite">
          {% if current_variant.price > 0 %}{{ current_variant.price | money_with_currency }}{% else %}Available soon{% endif %}
        </p>

        {% form 'product', product, id: product_form_id, class: 'db-product-form' %}
          {{ form.errors | default_errors }}
          {% unless product.has_only_default_variant %}
            <div class="db-field">
              <label for="db-variant-{{ section.id }}">{{ product.options | join: ' / ' | escape }}</label>
              <select id="db-variant-{{ section.id }}" name="id" data-db-variant>
                {% for variant in product.variants %}
                  <option
                    value="{{ variant.id }}"
                    {% if variant.id == current_variant.id %}selected{% endif %}
                    {% if variant.price <= 0 or variant.available == false %}disabled{% endif %}
                  >
                    {{ variant.title | escape }}{% if variant.price <= 0 %} — Available soon{% elsif variant.available == false %} — Sold out{% endif %}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-db-variant>
          {% endunless %}

          <div class="db-field db-field--quantity">
            <label for="db-quantity-{{ section.id }}">Quantity</label>
            <input id="db-quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" step="1" inputmode="numeric">
          </div>

          <button type="submit" name="add" class="db-button db-product-info__add" data-db-add {% unless can_purchase %}disabled{% endunless %}>
            {% if current_variant.price <= 0 %}Available soon{% elsif current_variant.available == false %}Sold out{% else %}Add to bag{% endif %}
          </button>
        {% endform %}

        {% if shop.shipping_policy.body != blank or shop.refund_policy.body != blank %}
          <div class="db-product-info__policies">
            {% if shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}">Shipping information</a>{% endif %}
            {% if shop.refund_policy.body != blank %}<a href="{{ shop.refund_policy.url }}">Returns policy</a>{% endif %}
          </div>
        {% endif %}

        {% if product.description != blank %}
          <div class="db-richtext db-product-info__description">{{ product.description }}</div>
        {% endif %}

        {% if product.metafields.custom.ingredients != blank %}
          <details class="db-product-info__detail">
            <summary>Ingredients</summary>
            <div class="db-richtext">{{ product.metafields.custom.ingredients | metafield_tag }}</div>
          </details>
        {% endif %}
        {% if product.metafields.custom.care != blank %}
          <details class="db-product-info__detail">
            <summary>Care</summary>
            <div class="db-richtext">{{ product.metafields.custom.care | metafield_tag }}</div>
          </details>
        {% endif %}
      </div>
    </div>
  </div>
  <script type="application/json" data-db-variants>{{ product.variants | json }}</script>
  <script type="application/json" data-db-variant-prices>{% capture variant_price_map %}{ {% for variant in product.variants %}{{ variant.id | append: '' | json }}: {{ variant.price | money_with_currency | json }}{% unless forloop.last %},{% endunless %}{% endfor %} }{% endcapture %}{{ variant_price_map }}</script>
</section>

{% schema %}
{
  "name": "Dear Body product",
  "settings": []
}
{% endschema %}
