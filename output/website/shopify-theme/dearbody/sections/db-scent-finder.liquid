<section class="db-finder-callout" aria-labelledby="finder-title-{{ section.id }}">
  {% render 'db-memphis-motif', shape: 'wave' %}
  <p class="db-kicker">{{ section.settings.eyebrow | escape }}</p>
  <h2 id="finder-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  <p>{{ section.settings.text | escape }}</p>
  <a href="{{ routes.all_products_collection_url }}" class="db-button db-button--cream" data-scent-quiz-open aria-haspopup="dialog" aria-controls="DearBodyScentQuiz">Find your scent <span aria-hidden="true">↗</span></a>
</section>
{% schema %}
{"name":"DearBody scent finder","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"LET YOUR FEELING LEAD"},{"type":"text","id":"heading","label":"Heading","default":"Which scent feels like you?"},{"type":"textarea","id":"text","label":"Text","default":"Three simple questions. Meet a fragrance that fits your taste."}],"presets":[{"name":"DearBody scent finder"}]}
{% endschema %}
