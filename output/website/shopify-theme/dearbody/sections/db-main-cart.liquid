<section class="db-section">
  <div class="db-container">
    <nav class="db-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Your bag</span>
    </nav>
    <h1 class="db-title">Your bag</h1>

    {% if cart.item_count > 0 %}
      {% assign cart_has_unavailable_items = false %}
      <form action="{{ routes.cart_url }}" method="post" class="db-cart-form" id="db-cart-form-{{ section.id }}">
        <div class="db-cart-table-wrap">
          <table class="db-cart-table">
            <caption class="db-visually-hidden">Items in your bag</caption>
            <thead>
              <tr>
                <th scope="col">Fragrance</th>
                <th scope="col">Quantity</th>
                <th scope="col">Total</th>
              </tr>
            </thead>
            <tbody>
              {% for item in cart.items %}
                {% liquid
                  if item.original_price <= 0 or item.variant.price <= 0 or item.variant.available == false
                    assign cart_has_unavailable_items = true
                  endif
                %}
                <tr class="db-cart-table__row">
                  <td>
                    <div class="db-cart-item">
                      {% if item.image %}
                        <a class="db-cart-item__image" href="{{ item.url }}" aria-label="View {{ item.product.title | escape }}">
                          {% assign cart_image_alt = item.image.alt | default: item.product.title %}
                          {{ item.image | image_url: width: 240 | image_tag: widths: '120, 240', sizes: '120px', loading: 'lazy', alt: cart_image_alt }}
                        </a>
                      {% endif %}
                      <div class="db-cart-item__details">
                        <a class="db-cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                        {% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}
                        {% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
                        {% for property in item.properties %}
                          {% assign property_first_character = property.first | slice: 0 %}
                          {% if property.last != blank and property_first_character != '_' %}
                            <p>{{ property.first | escape }}: {{ property.last | escape }}</p>
                          {% endif %}
                        {% endfor %}
                        {% if item.original_price <= 0 or item.variant.price <= 0 %}
                          <p class="db-cart-item__status">Available soon</p>
                        {% elsif item.variant.available == false %}
                          <p class="db-cart-item__status">Sold out</p>
                        {% else %}
                          <p class="db-cart-item__unit-price">{{ item.final_price | money_with_currency }} each</p>
                        {% endif %}
                        <a class="db-cart-item__remove" href="{{ item.url_to_remove }}" aria-label="Remove {{ item.product.title | escape }} from your bag">Remove</a>
                      </div>
                    </div>
                  </td>
                  <td>
                    <div class="db-field db-field--quantity">
                      <label for="db-cart-quantity-{{ section.id }}-{{ forloop.index }}" class="db-visually-hidden">Quantity for {{ item.product.title | escape }}{% unless item.product.has_only_default_variant %}, {{ item.variant.title | escape }}{% endunless %}</label>
                      <input id="db-cart-quantity-{{ section.id }}-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="1" inputmode="numeric" aria-label="Quantity for {{ item.title | escape }}">
                    </div>
                  </td>
                  <td class="db-cart-table__total">
                    {% if item.original_price <= 0 or item.variant.price <= 0 %}Unavailable{% else %}{{ item.final_line_price | money_with_currency }}{% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <div class="db-cart-actions">
          <a class="db-button db-button--outline" href="{{ routes.all_products_collection_url }}">Continue exploring</a>
          <button type="submit" name="update" class="db-button db-button--outline">Update bag</button>
        </div>

        <div class="db-cart-summary">
          {% for discount in cart.cart_level_discount_applications %}
            <p class="db-cart-summary__discount"><span>{{ discount.title | escape }}</span> <span>−{{ discount.total_allocated_amount | money_with_currency }}</span></p>
          {% endfor %}
          <p class="db-cart-summary__subtotal"><span>Subtotal</span> <span class="db-price">{{ cart.total_price | money_with_currency }}</span></p>
          <p class="db-cart-summary__note">Final total and available delivery options are shown at checkout.</p>
          {% if shop.shipping_policy.body != blank %}<p><a href="{{ shop.shipping_policy.url }}">Shipping information</a></p>{% endif %}
          {% if cart_has_unavailable_items %}
            <p class="db-cart-summary__notice" role="status">One or more fragrances in your bag are currently unavailable. Remove them to continue to checkout.</p>
          {% endif %}
          <button type="submit" name="checkout" class="db-button" {% if cart_has_unavailable_items %}disabled{% endif %}>Checkout</button>
        </div>
      </form>
    {% else %}
      <div class="db-empty">
        <h2>Your scent journey starts here.</h2>
        <p>Your bag is empty. Explore the collection and find your next fragrance.</p>
        <a class="db-button" href="{{ routes.all_products_collection_url }}">Explore the collection</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Dear Body cart",
  "settings": []
}
{% endschema %}
