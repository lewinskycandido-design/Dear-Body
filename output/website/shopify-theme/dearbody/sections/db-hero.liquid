<section class="db-hero" aria-labelledby="hero-title-{{ section.id }}">
  {% render 'db-memphis-motif', shape: 'wave' %}
  {% render 'db-memphis-motif', shape: 'ring' %}
  <div class="db-hero-copy">
    <p class="db-kicker">{{ section.settings.eyebrow | escape }}</p>
    <h1 id="hero-title-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h1>
    <p>{{ section.settings.text | escape }}</p>
    <a class="db-button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }} <span aria-hidden="true">↗</span></a>
  </div>
  <div class="db-hero-photo">
    <picture>
      {% if section.settings.mobile_image %}<source media="(max-width:700px)" srcset="{{ section.settings.mobile_image | image_url: width: 1200 }}">{% endif %}
      {% if section.settings.image %}
        {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '500, 800, 1122, 1400', sizes: '(max-width:700px) 90vw, 540px', loading: 'eager', fetchpriority: 'high', alt: 'Six DearBody fragrances displayed together in a sunlit home' }}
      {% else %}
        <img src="{{ 'db-hero-mobile.jpg' | asset_url }}" width="1122" height="1402" alt="Six DearBody fragrances displayed together in a sunlit home" fetchpriority="high">
      {% endif %}
    </picture>
    <span class="db-hero-sticker" aria-hidden="true"><span>MAKE IT<br>YOURS.</span></span>
  </div>
</section>
<div class="db-brand-line"><span>London-formulated</span><span class="db-brand-line-mark" aria-hidden="true">✳</span><span>For everyday self-expression</span><span class="db-brand-line-mark" aria-hidden="true">✳</span><span>Dear Body Philippines</span></div>
{% schema %}
{"name":"DearBody collection hero","settings":[{"type":"image_picker","id":"image","label":"Hero photo (4:5 recommended)"},{"type":"image_picker","id":"mobile_image","label":"Optional mobile photo"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"DEAR BODY PHILIPPINES"},{"type":"textarea","id":"heading","label":"Heading","default":"A SCENT\nJOURNEY."},{"type":"textarea","id":"text","label":"Text","default":"London-formulated fragrances, curated for the way you live."},{"type":"text","id":"button","label":"Button label","default":"Explore the collection"},{"type":"url","id":"link","label":"Button link","default":"/collections/all"}],"presets":[{"name":"DearBody collection hero"}]}
{% endschema %}
