{% liquid
  assign card_name = product.title | default: fallback_name
  assign card_url = product.url
  assign card_price = 0
  assign card_price_max = 0
  for variant in product.variants
    if variant.price > 0
      if card_price == 0 or variant.price < card_price
        assign card_price = variant.price
      endif
      if variant.price > card_price_max
        assign card_price_max = variant.price
      endif
    endif
  endfor
%}
<article class="db-card">
  {% if card_url != blank %}<a class="db-card-image" href="{{ card_url }}" aria-label="Explore {{ card_name | escape }}">{% else %}<div class="db-card-image">{% endif %}
    {% if fallback_image != blank %}<img src="{{ fallback_image | asset_url }}" alt="{{ card_name | escape }} bottle and presentation canister" width="900" height="900" loading="lazy">{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: widths: '300, 500, 700, 900', sizes: '(max-width:700px) 50vw, 33vw', loading: 'lazy', alt: card_name }}{% else %}<div class="db-no-image">{{ card_name | escape }}</div>{% endif %}
    {% if card_url != blank %}<span class="db-card-arrow" aria-hidden="true">↗</span>{% endif %}
  {% if card_url != blank %}</a>{% else %}</div>{% endif %}
  <div class="db-card-meta"><h3>{% if card_url != blank %}<a href="{{ card_url }}">{{ card_name | escape }}</a>{% else %}{{ card_name | escape }}{% endif %}</h3><p>{% if card_price > 0 %}{% if card_price_max > card_price %}From {% endif %}{{ card_price | money_with_currency }}{% else %}Available soon{% endif %}</p></div>
  {% if card_url != blank %}<a class="db-text-link" href="{{ card_url }}">View fragrance <span aria-hidden="true">↗</span></a>{% endif %}
</article>
