<details class="sj-scent-picker" data-sj-scent-picker>
  <summary>Choose a scent to add <span aria-hidden="true">⌄</span></summary>
  <div class="sj-scent-picker__options" role="group" aria-label="Choose your fragrance">
    {% for handle in order_handles %}
      {% assign scent = all_products[handle] %}
      {% if scent != blank %}
        {% capture prefix %}{% render 'sj-gallery-prefix', product: scent %}{% endcapture %}
        {% assign prefix = prefix | strip %}
        {% for variant in scent.variants %}
          <button type="button" class="sj-scent-picker__option" data-sj-collection-add value="{{ variant.id }}" disabled>
            {% if prefix != blank %}
              {% assign thumbnail = prefix | append: '-01-thumb.jpg' %}
              <img src="{{ thumbnail | asset_url }}" width="64" height="64" alt="" loading="lazy">
            {% elsif scent.featured_image %}
              {{ scent.featured_image | image_url: width: 160 | image_tag: width: 64, height: 64, alt: '', loading: 'lazy' }}
            {% endif %}
            <span class="sj-scent-picker__copy"><strong>{{ scent.title | escape }}</strong>{% unless scent.has_only_default_variant %}<span>{{ variant.title | escape }}</span>{% endunless %}<span>{{ variant.price | money }}</span><small data-sj-order-add-label>{% if variant.available %}Add to order{% else %}Sold out{% endif %}</small></span>
          </button>
        {% endfor %}
      {% endif %}
    {% endfor %}
  </div>
</details>
