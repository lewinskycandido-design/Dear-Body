<section class="sj-newsletter"><div><p class="sj-eyebrow">STAY IN THE JOURNEY</p><h2>{{ section.settings.heading | escape }}</h2></div><div><p>{{ section.settings.description | escape }}</p>{% assign form_id = 'Newsletter-' | append: section.id %}{% form 'customer', id: form_id %}<input type="hidden" name="contact[tags]" value="newsletter">{% if form.posted_successfully? %}<p role="status">You're on the list. Welcome to the journey.</p>{% else %}{{ form.errors | default_errors }}<label for="newsletter-{{ section.id }}">Email address</label><div class="sj-newsletter-input"><input id="newsletter-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="Your email address" required><button type="submit">JOIN US</button></div><small>By subscribing, you agree to receive DearBody updates. Unsubscribe anytime. <a href="{{ shop.privacy_policy.url | default: '/pages/privacy' }}">Privacy policy</a></small>{% endif %}{% endform %}</div></section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE NEXT CHAPTER, IN YOUR INBOX."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "New scents, fresh stories, and a little everyday inspiration."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
