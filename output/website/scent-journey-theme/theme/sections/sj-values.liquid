<section class="sj-container sj-section"><div class="sj-section-heading"><div><p class="sj-eyebrow">THE DEARBODY POINT OF VIEW</p><h2>{{ section.settings.heading | escape }}</h2></div></div><div class="sj-values">{% for block in section.blocks %}<article class="sj-value" {{ block.shopify_attributes }}><span>0{{ forloop.index }} /</span><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.description | escape }}</p></article>{% endfor %}</div></section>
{% schema %}
{
  "name": "Why DearBody",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FRAGRANCE. WITH PERSONALITY."
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Brand value",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "London-formulated"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "International fragrance character, thoughtfully brought into your everyday."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why DearBody"
    }
  ]
}
{% endschema %}
