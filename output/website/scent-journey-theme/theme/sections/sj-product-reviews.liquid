{{ 'sj-reviews.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign approved_count = 0
  assign approved_total = 0
  assign app_count = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_count = app_count | plus: 1
    elsif block.type == 'review' and block.settings.approved and block.settings.product.id == product.id and block.settings.reviewer != blank and block.settings.review != blank
      assign block_rating = block.settings.rating | plus: 0
      if block_rating >= 1 and block_rating <= 5
        assign approved_count = approved_count | plus: 1
        assign approved_total = approved_total | plus: block_rating
      endif
    endif
  endfor
  assign approved_average = 0
  if approved_count > 0
    assign approved_average = approved_total | times: 1.0 | divided_by: approved_count
  endif
  assign native_count = product.metafields.reviews.rating_count.value | plus: 0
  assign native_rating = product.metafields.reviews.rating.value.rating | plus: 0
  assign review_anchor = 'ProductReviews-' | append: product.id
  assign empty_summary = 'No reviews yet'
  if app_count > 0
    assign empty_summary = 'Customer reviews'
  endif
-%}
<section id="{{ review_anchor }}" class="sj-product-reviews" aria-labelledby="ReviewsHeading-{{ section.id }}">
  <div class="sj-container">
    <header class="sj-product-reviews__header">
      <div><p class="sj-eyebrow">YOUR SCENT, YOUR STORY</p><h2 id="ReviewsHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
      {% render 'sj-rating-summary', product: product, fallback_rating: approved_average, fallback_count: approved_count, empty_text: empty_summary, target: review_anchor %}
    </header>
    <div class="sj-product-reviews__layout">
      <div class="sj-product-reviews__published">
        {%- if approved_count > 0 -%}
          <ul class="sj-product-reviews__list" role="list">
            {%- for block in section.blocks -%}
              {%- assign block_rating = block.settings.rating | plus: 0 -%}
              {%- if block.type == 'review' and block.settings.approved and block.settings.product.id == product.id and block.settings.reviewer != blank and block.settings.review != blank and block_rating >= 1 and block_rating <= 5 -%}
                <li class="sj-review-card" {{ block.shopify_attributes }}>
                  <article aria-labelledby="ReviewAuthor-{{ section.id }}-{{ block.id }}">
                    <div class="sj-review-card__heading"><h3 id="ReviewAuthor-{{ section.id }}-{{ block.id }}">{{ block.settings.reviewer | escape }}</h3><span class="sj-review-card__rating"><span aria-hidden="true">★</span> {{ block_rating }} out of 5</span></div>
                    {% if block.settings.title != blank %}<p class="sj-review-card__title">{{ block.settings.title | escape }}</p>{% endif %}
                    <div class="sj-review-card__body">{{ block.settings.review | escape | newline_to_br }}</div>
                  </article>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- elsif app_count == 0 and native_count == 0 and native_rating == 0 -%}
          <div class="sj-product-reviews__empty">
            <h3>No reviews yet.</h3><p>Customer feedback for {{ product.title | escape }} will appear here.</p>
          </div>
        {%- endif -%}
        {% for block in section.blocks %}{% if block.type == '@app' %}<div class="sj-product-reviews__app" {{ block.shopify_attributes }}>{% render block %}</div>{% endif %}{% endfor %}
      </div>
    </div>
  </div>
</section>
{% if section.settings.show_samples %}{% render 'sj-sample-reviews', product: product %}{% endif %}
{% schema %}
{
  "name": "Product reviews",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 50,
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Customer reviews" }, {"type":"checkbox","id":"show_samples","label":"Show illustrative sample reviews","default":true}],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "Approved customer review",
      "settings": [
        { "type": "paragraph", "content": "Use a genuine customer review with permission to publish. Select the exact product and approve it before it becomes visible. Keep private email addresses out of these fields." },
        { "type": "product", "id": "product", "label": "Reviewed product" },
        { "type": "checkbox", "id": "approved", "label": "Approved for publication", "default": false },
        { "type": "text", "id": "reviewer", "label": "Customer display name" },
        { "type": "range", "id": "rating", "label": "Customer's rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Review title (optional)" },
        { "type": "textarea", "id": "review", "label": "Customer's review" }
      ]
    }
  ],
  "presets": [{ "name": "Product reviews" }]
}
{% endschema %}
