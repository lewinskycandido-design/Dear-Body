<section class="sj-container sj-section"><div class="sj-campaign-grid">{% for block in section.blocks %}{% liquid
 assign campaign_product = block.settings.product
 assign campaign_image = block.settings.image
 if campaign_image == blank and campaign_product != blank
  assign campaign_image = campaign_product.images[4]
 endif
%}<article class="sj-campaign" {{ block.shopify_attributes }}>{% if campaign_image != blank %}<div class="sj-campaign-photo">{{ campaign_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width: 760px) 45vw, 90vw' }}<span class="sj-campaign-letter" aria-hidden="true">{{ block.settings.number | escape }}</span></div>{% endif %}<div class="sj-campaign-copy"><p class="sj-eyebrow">{{ block.settings.eyebrow | escape }}</p><h2>{{ block.settings.heading | escape | newline_to_br }}</h2><a class="sj-text-link" href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}">{{ block.settings.cta | escape }}</a></div></article>{% endfor %}</div></section>
{% schema %}
{
  "name": "Women and men campaigns",
  "max_blocks": 2,
  "settings": [],
  "blocks": [
    {
      "type": "campaign",
      "name": "Campaign",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Chapter number",
          "default": "04"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "THE WOMEN’S COLLECTION"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "default": "A SCENT FOR\nEVERY VERSION\nOF YOU."
        },
        {
          "type": "text",
          "id": "cta",
          "label": "CTA",
          "default": "Explore women"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product editorial image fallback"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Campaign image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Women and men campaigns"
    }
  ]
}
{% endschema %}
