<sj-recommendations class="sj-product-recommendations" data-sj-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&amp;product_id={{ product.id }}&amp;limit={{ section.settings.product_limit }}&amp;intent=related"{% unless recommendations.performed and recommendations.products_count > 0 %} hidden{% endunless %}>
  {% if recommendations.performed and recommendations.products_count > 0 %}
    <section aria-labelledby="Recommendations-{{ section.id }}">
      <p class="sj-eyebrow">Keep exploring</p>
      <h2 id="Recommendations-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <div class="sj-product-recommendations__grid">
        {% for recommendation in recommendations.products %}
          <a class="sj-product-recommendations__card" href="{{ recommendation.url }}">
            <div class="sj-product-recommendations__image">{% render 'sj-product-image', product: recommendation, alt: recommendation.title %}</div>
            <h3>{{ recommendation.title | escape }}</h3>
            <p>{% render 'sj-price', product: recommendation %}</p>
          </a>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</sj-recommendations>
{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also love" },
    { "type": "range", "id": "product_limit", "label": "Maximum products", "min": 2, "max": 6, "step": 1, "default": 4 }
  ]
}
{% endschema %}
