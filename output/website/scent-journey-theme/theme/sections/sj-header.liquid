{{ 'sj-offers.css' | asset_url | stylesheet_tag }}
{{ 'sj-color-icons.css' | asset_url | stylesheet_tag }}
<div class="sj-header-shell" data-sj-header>
<div class="sj-announcement sj-announcement--shipping">{% render 'sj-shipping-offer', variant: 'announcement' %}</div>
<header class="sj-header">
{% render 'sj-logo' %}
<nav class="sj-desktop-nav" aria-label="Main navigation">
<a href="{% render 'sj-nav-url', url: settings.women_collection.url, fallback: '/collections/womens-perfume' %}">Women</a><a href="{% render 'sj-nav-url', url: settings.men_collection.url, fallback: '/collections/mens-perfume' %}">Men</a><a href="{% render 'sj-nav-url', url: settings.finder_url, fallback: '/pages/scent-finder' %}">Scent Finder</a><a href="{% render 'sj-nav-url', url: settings.story_url, fallback: '/pages/our-story' %}">Our Story</a>
</nav>
<div class="sj-header-actions">
{% if settings.compare_mode %}
<button class="sj-theme-toggle" type="button" data-sj-theme-toggle aria-label="Switch to {% if settings.visual_theme == 'dark' %}light{% else %}dark{% endif %} mode" title="Switch to {% if settings.visual_theme == 'dark' %}light{% else %}dark{% endif %} mode">
{% render 'sj-icon', name: 'moon', class: 'sj-header-icon sj-theme-toggle__moon' %}
{% render 'sj-icon', name: 'sun', class: 'sj-header-icon sj-theme-toggle__sun' %}
</button>
{% endif %}
<a href="{{ routes.cart_url }}" data-sj-open-cart aria-label="Open cart">{% render 'sj-icon', name: 'bag', class: 'sj-header-icon' %}<span>Cart (<span data-sj-cart-count>{{ cart.item_count }}</span>)</span></a><a href="{{ routes.search_url }}" data-sj-open-search aria-label="Search fragrances">{% render 'sj-icon', name: 'search', class: 'sj-header-icon sj-search-icon' %}<span>Search</span></a><button class="sj-menu-toggle" type="button" data-sj-menu aria-label="Menu" aria-controls="sj-mobile-menu" aria-expanded="false">{% render 'sj-icon', name: 'menu', class: 'sj-header-icon sj-menu-icon' %}</button></div>
<nav id="sj-mobile-menu" class="sj-mobile-nav" hidden aria-label="Mobile navigation"><a href="{% render 'sj-nav-url', url: settings.women_collection.url, fallback: '/collections/womens-perfume' %}">Women</a><a href="{% render 'sj-nav-url', url: settings.men_collection.url, fallback: '/collections/mens-perfume' %}">Men</a><a href="{% render 'sj-nav-url', url: settings.finder_url, fallback: '/pages/scent-finder' %}">Scent Finder</a><a href="{% render 'sj-nav-url', url: settings.story_url, fallback: '/pages/our-story' %}">Our Story</a><a href="{{ routes.all_products_collection_url }}">Shop all</a></nav>
</header></div>
{% schema %}{"name":"Site header","settings":[{"type":"paragraph","content":"The header displays free shipping on 2 or more items, with the single-item shipping condition and a link to Shipping details."}]}{% endschema %}
