<section class="sj-story-page"><header class="sj-page-banner sj-page-banner--story"><div class="sj-page-banner__media">{% render 'sj-themed-photo', light_asset: 'sj-banner-story-light.jpg', dark_asset: 'sj-banner-story-dark.jpg', light_image: section.settings.banner_light, dark_image: section.settings.banner_dark, alt: '', loading: 'eager', width: 1774, height: 887 %}</div><div class="sj-page-banner__inner sj-container"><div class="sj-page-banner__copy"><p class="sj-eyebrow">OUR STORY / DEARBODY PHILIPPINES</p><h1>{{ section.settings.heading | escape | newline_to_br }}</h1></div></div></header><div class="sj-container"><div class="sj-story-essay"><h2>{{ section.settings.subheading | escape }}</h2><div><p>{{ section.settings.body_one | escape }}</p><p>{{ section.settings.body_two | escape }}</p><a class="sj-button" href="{{ routes.all_products_collection_url }}">Explore the collection</a></div></div><div class="sj-story-lifestyle"><figure>{% render 'sj-themed-photo', light_asset: 'sj-women-light.jpg', dark_asset: 'sj-women-dark.jpg', alt: 'A Filipina brings playful colour and personal style to a sunlit everyday moment', width: 1073, height: 1466 %}<figcaption>Make every moment feel personal.</figcaption></figure><figure>{% render 'sj-themed-photo', light_asset: 'sj-men-light.jpg', dark_asset: 'sj-men-dark.jpg', alt: 'A Filipino man in bold casual clothing enjoys a sunny everyday moment', width: 1073, height: 1466 %}<figcaption>A little more personality, every day.</figcaption></figure></div><div class="sj-story-essay sj-story-closing"><div class="sj-story-closing__heading"><p class="sj-eyebrow">FRAGRANCE, WITH PERSONALITY.</p><h2>Everyday life.<br>Extraordinary you.</h2></div><div class="sj-story-closing__copy"><p>Some days call for something bright. Others invite a little mystery. Your fragrance can be as expressive, playful, and individual as you are.</p><p>Wear what feels right today. There’s always room to try something different.</p><a class="sj-text-link" href="{{ settings.finder_url | default: '/pages/scent-finder' }}">Find your fragrance</a></div></div></div></section>
{% schema %}
{
  "name": "Our Story",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "A SCENT JOURNEY\nFROM LONDON\nTO THE PHILIPPINES."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A world of fragrance. A feeling of home."
    },
    {
      "type": "textarea",
      "id": "body_one",
      "label": "Introduction",
      "default": "DearBody Philippines brings London's fragrance culture into Filipino everyday life through London-formulated scents thoughtfully curated for local tastes, lifestyles, and tropical conditions."
    },
    {
      "type": "textarea",
      "id": "body_two",
      "label": "Brand story",
      "default": "We believe fragrance belongs in the everyday: the morning you make your own, the plans you say yes to, the moments that become memories. International fragrance character meets Filipino personality — and a little more room for self-expression."
    },
    {
      "type": "image_picker",
      "id": "banner_light",
      "label": "Header banner — Light"
    },
    {
      "type": "image_picker",
      "id": "banner_dark",
      "label": "Header banner — Dark"
    }
  ]
}
{% endschema %}

