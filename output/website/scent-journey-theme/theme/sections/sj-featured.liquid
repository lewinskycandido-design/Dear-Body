{% assign featured = section.settings.product %}{% if featured != blank %}<section class="sj-container sj-section"><div class="sj-featured">{% assign editorial = section.settings.image | default: featured.images[5] | default: featured.featured_image %}{{ editorial | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '400,600,900,1100', sizes: '(min-width: 760px) 48vw, 90vw' }}<div class="sj-featured-copy"><p class="sj-eyebrow">05 — IN THE SPOTLIGHT / {{ featured.title | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p><a class="sj-button" href="{{ featured.url }}">Meet {{ featured.title | escape }}</a></div></div></section>{% endif %}
{% schema %}
{
  "name": "Fragrance editorial",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Featured fragrance"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial image"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "DARK SPICE. SMOKE. ADDICTIVE WARMTH."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A darker turn in your scent journey. Discover Amber Oud Silk — a fragrance with smoky warmth and an expressive, spiced character."
    }
  ],
  "presets": [
    {
      "name": "Fragrance editorial"
    }
  ]
}
{% endschema %}
