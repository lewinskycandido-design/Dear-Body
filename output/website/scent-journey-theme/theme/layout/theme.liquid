<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-theme="{{ settings.visual_theme | default: 'light' }}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="{% if settings.visual_theme == 'dark' %}#2B080E{% else %}#F4E3CB{% endif %}">
{% render 'sj-seo' %}
{% render 'sj-favicon' %}
{% if settings.compare_mode %}<script>try{var m=new URLSearchParams(location.search).get('visual_theme')||sessionStorage.getItem('sj-visual-theme');if(m==='light'||m==='dark')document.documentElement.dataset.theme=m}catch(e){}</script>{% endif %}
{{ 'sj-base.css' | asset_url | stylesheet_tag }}
{{ 'sj-commerce.css' | asset_url | stylesheet_tag }}
{{ 'sj-price.css' | asset_url | stylesheet_tag }}
{{ 'sj-buttons.css' | asset_url | stylesheet_tag }}
{{ 'sj-shipping-cards.css' | asset_url | stylesheet_tag }}
{% render 'sj-fonts' %}
<style>:root{--page-width:{{ settings.page_width | default: 1800 }}px;--section-space:{{ settings.section_spacing | default: 112 }}px}@media(max-width:760px){:root{--section-space:{{ settings.mobile_section_spacing | default: 64 }}px}}{% if settings.editorial_alignment == 'center' %}.sj-hero-intro{grid-template-columns:1fr;text-align:center;gap:32px}.sj-hero-intro h1{max-width:1100px;margin-inline:auto}.sj-hero .sj-eyebrow{justify-content:center}.sj-hero-description{max-width:550px;margin-inline:auto}.sj-hero-actions{justify-content:center}.sj-doorway-intro{grid-template-columns:1fr;text-align:center}.sj-doorway-intro h2,.sj-doorway-intro>p:last-child{margin-inline:auto}.sj-doorway-intro>p:last-child{max-width:550px}{% endif %}</style>
{{ content_for_header }}
<script>window.sjRoutes={root:{{ routes.root_url | json }},cart:{{ routes.cart_url | json }},search:{{ routes.search_url | json }},predictive:{{ routes.predictive_search_url | json }}};</script>
<script src="{{ 'sj-base.js' | asset_url }}" defer></script><script src="{{ 'sj-commerce.js' | asset_url }}" defer></script>
</head>
<body class="sj-page-type-{{ request.page_type }}">
<a class="sj-skip" href="#MainContent">Skip to content</a>
{% sections 'header-group' %}
<main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
{% sections 'footer-group' %}
{% section 'sj-predictive-search' %}
{% section 'sj-cart-drawer' %}
{{ 'sj-image-select.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sj-image-select.js' | asset_url }}" defer></script>
{{ 'sj-compact.css' | asset_url | stylesheet_tag }}
</body></html>
