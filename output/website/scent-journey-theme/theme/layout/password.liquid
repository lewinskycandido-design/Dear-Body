<!doctype html><html lang="{{ request.locale.iso_code }}" data-theme="{{ settings.visual_theme | default: 'light' }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ shop.name | escape }}</title>{% render 'sj-favicon' %}{% render 'sj-fonts' %}{{ 'sj-base.css' | asset_url | stylesheet_tag }}{% if settings.compare_mode %}<script>try{var m=new URLSearchParams(location.search).get('visual_theme')||sessionStorage.getItem('sj-visual-theme');if(m==='light'||m==='dark')document.documentElement.dataset.theme=m}catch(e){}</script>{% endif %}{{ content_for_header }}</head><body>{{ content_for_layout }}</body></html>
