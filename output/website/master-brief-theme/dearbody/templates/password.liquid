{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#5c0006"><title>{{ shop.name | escape }} — A scent journey</title>{{ content_for_header }}{{ 'dearbody.css' | asset_url | stylesheet_tag }}{{ 'dearbody-memphis.css' | asset_url | stylesheet_tag }}</head>
<body><main class="db-password"><div><a href="{{ routes.root_url }}" class="db-wordmark">{% if settings.logo %}{{ settings.logo | image_url: width: 440 | image_tag: width: 220, loading: 'eager', alt: shop.name }}{% else %}{% render 'db-logo' %}{% endif %}</a><p class="db-kicker">SOMETHING GOOD IS ON ITS WAY</p><h1>A SCENT<br>JOURNEY.</h1>{% if shop.password_message != blank %}<div class="db-richtext">{{ shop.password_message }}</div>{% else %}<p>London-formulated fragrances, curated for the way you live.</p>{% endif %}{% form 'storefront_password' %}{{ form.errors | default_errors }}<label class="db-field" for="StorePassword">Store password<input type="password" name="password" id="StorePassword" autocomplete="current-password" required></label><button type="submit" class="db-button">Enter store</button>{% endform %}</div></main></body></html>
