<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#5c0006">
    <link rel="canonical" href="{{ canonical_url }}">
    {% capture seo_title %}{% render 'db-seo', field: 'title' %}{% endcapture %}
    {% capture seo_description %}{% render 'db-seo', field: 'description' %}{% endcapture %}
    <title>{{ seo_title | strip | escape }}</title>
    <meta name="description" content="{{ seo_description | strip | escape }}">
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:title" content="{{ seo_title | strip | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
    <meta property="og:description" content="{{ seo_description | strip | escape }}">
    {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
    {% if settings.favicon %}<link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}">{% endif %}
    {{ content_for_header }}
    {{ 'dearbody.css' | asset_url | stylesheet_tag }}
    {{ 'dearbody-quiz.css' | asset_url | stylesheet_tag }}
    {{ 'dearbody-master.css' | asset_url | stylesheet_tag }}
    {{ 'dearbody-commerce.css' | asset_url | stylesheet_tag }}
    {% render 'db-fonts' %}
    <script src="{{ 'dearbody.js' | asset_url }}" defer></script>
    <script src="{{ 'dearbody-quiz.js' | asset_url }}" defer></script>
    <script src="{{ 'dearbody-commerce.js' | asset_url }}" defer></script>
  </head>
  <body class="db-site db-master db-template-{{ template.name }}">
    <a class="db-skip-link" href="#MainContent">Skip to content</a>
    {% sections 'header-group' %}
    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
    {% sections 'footer-group' %}

  </body>
</html>
