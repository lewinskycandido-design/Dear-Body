<footer class="db-footer"><div class="db-container"><div class="db-footer-top"><a class="db-wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">{% if settings.footer_logo %}{{ settings.footer_logo | image_url: width: 440 | image_tag: width: 220, loading: 'lazy', alt: shop.name }}{% else %}<span class="db-home-link">Home</span>{% endif %}</a><p>LONDON-FORMULATED.<br>CURATED FOR FILIPINO LIFE.</p></div><div class="db-footer-columns"><div><p class="db-kicker">Your next chapter</p><nav aria-label="Footer navigation">{% render 'db-navigation' %}<a href="{{ routes.all_products_collection_url }}">Shop all</a></nav></div><div><p class="db-kicker">Here to help</p><nav aria-label="Customer care">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</nav></div><div class="db-footer-note">{% render 'db-secondary-logo' %}<p>Fragrance for your mood.<br>Your moments. Your story.</p></div></div><p class="db-footer-statement">A SCENT JOURNEY.</p><div class="db-footer-bottom"><small>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</small><a href="#MainContent">Back to top ↑</a></div></div></footer>
{% schema %}
{
  "name": "DearBody footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Customer care menu"
    }
  ]
}
{% endschema %}
