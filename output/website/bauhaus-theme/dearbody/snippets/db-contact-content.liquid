{% liquid
  assign banner_title = section.settings.banner_heading | default: "LET'S TALK."
  assign banner_kicker = section.settings.banner_kicker | default: 'CONTACT DEAR BODY'
  assign banner_text = section.settings.banner_text | default: "A question, a thought, a little hello. We'd love to hear from you."
%}
{% render 'db-page-banner', title: banner_title, kicker: banner_kicker, text: banner_text, variant: 'contact', image: section.settings.banner_image, asset: 'db-banner-contact.jpg', image_alt: 'Cream telephone with a burgundy handset beside a note card in a warm home setting', width: 1536, height: 1024, section_id: section.id, root_url: routes.root_url %}
<section class="db-container db-section db-contact"><div><h2 class="db-lead">SEND A MESSAGE.</h2><p>Send us a message using the form.</p>{% if page.content != blank %}<div class="db-richtext">{{ page.content }}</div>{% endif %}</div><div>{% assign form_id = 'Contact-' | append: section.id %}{% form 'contact', id: form_id %}{% if form.posted_successfully? %}<div class="db-success" role="status"><h2>Message received.</h2><p>Thank you for getting in touch with Dear Body.</p></div>{% else %}{{ form.errors | default_errors }}<div class="db-form-grid"><label class="db-field" for="ContactName">Name<input id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></label><label class="db-field" for="ContactEmail">Email<input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | escape }}" required></label></div><label class="db-field" for="ContactOrder">Order number <span>(optional)</span><input id="ContactOrder" name="contact[order_number]"></label><label class="db-field" for="ContactBody">Message<textarea id="ContactBody" name="contact[body]" rows="7" required>{{ form.body | escape }}</textarea></label><button class="db-button" type="submit">Send message <span aria-hidden="true">↗</span></button>{% endif %}{% endform %}</div></section>
