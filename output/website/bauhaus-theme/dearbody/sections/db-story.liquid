<section class="db-story db-container db-section"><div class="db-story-seal">{% render 'db-secondary-logo', settings: settings %}<span>A SCENT JOURNEY</span></div><div class="db-story-content"><p class="db-kicker">{{ section.settings.eyebrow | escape }}</p><div class="db-story-columns"><h2>{{ section.settings.heading | escape | newline_to_br }}</h2><div><p>{{ section.settings.text | escape }}</p><a class="db-text-link" href="{{ routes.root_url | append: '/pages/our-story' | replace: '//', '/' }}">Discover our story <span aria-hidden="true">↗</span></a></div></div></div></section>
{% schema %}
{"name":"DearBody brand story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FROM LONDON TO YOUR EVERYDAY"},{"type":"textarea","id":"heading","label":"Heading","default":"PERSONAL,\nNOT PRECIOUS."},{"type":"textarea","id":"text","label":"Text","default":"Dear Body brings London's fragrance culture into everyday Filipino life. Warm, vibrant, and full of personality, our London-formulated fragrances invite you to make scent part of your own story."}],"presets":[{"name":"DearBody brand story"}]}
{% endschema %}
