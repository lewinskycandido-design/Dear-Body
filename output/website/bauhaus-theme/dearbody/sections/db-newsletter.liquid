<section class="db-newsletter"><div class="db-container db-newsletter-inner"><div><p class="db-kicker">STAY IN THE STORY</p><h2>{{ section.settings.heading | escape }}</h2><p>New arrivals and stories from Dear Body.</p></div><div>{% assign form_id = 'Newsletter-' | append: section.id %}{% form 'customer', id: form_id %}<input type="hidden" name="contact[tags]" value="newsletter">{% if form.posted_successfully? %}<p role="status">You're on the list. Welcome to Dear Body.</p>{% else %}<label for="NewsletterEmail-{{ section.id }}">Email address</label><div class="db-inline-form"><input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="Your email address"><button class="db-button" type="submit">Join us <span aria-hidden="true">↗</span></button></div>{{ form.errors | default_errors }}<p class="db-form-note">By subscribing, you agree to receive marketing emails. You can unsubscribe at any time.{% if shop.privacy_policy.body != blank %} <a href="{{ shop.privacy_policy.url }}">Privacy policy</a>.{% endif %}</p>{% endif %}{% endform %}</div></div></section>
{% schema %}
{"name":"DearBody newsletter","settings":[{"type":"text","id":"heading","label":"Heading","default":"YOUR NEXT SCENT JOURNEY."}],"presets":[{"name":"DearBody newsletter"}]}
{% endschema %}
